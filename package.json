{
  "name": "modbear",
  "displayName": "ModBear",
  "description": "Dependency updates and lifecycle insights for Go modules, directly inside VS Code.",
  "version": "1.2.0",
  "publisher": "diaszano",
  "icon": "resources/modbear.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Diaszano/modbear"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "go",
    "golang",
    "dependencies",
    "security",
    "go.mod"
  ],
  "activationEvents": [
    "workspaceContains:**/go.mod",
    "onLanguage:go.mod"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%workspaceTrust.description%",
      "restrictedConfigurations": [
        "modBear.go.path",
        "modBear.govulncheck.path"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The extension requires local Go tooling and filesystem access."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "modBear.scanWorkspace",
        "title": "ModBear: Scan Workspace"
      },
      {
        "command": "modBear.scanModule",
        "title": "ModBear: Scan Current Module"
      },
      {
        "command": "modBear.showDetails",
        "title": "ModBear: Show Dependency Details"
      },
      {
        "command": "modBear.copySuggestion",
        "title": "ModBear: Copy Suggested Command"
      },
      {
        "command": "modBear.showOutput",
        "title": "ModBear: Show Output"
      },
      {
        "command": "modBear.showStatusBarMenu",
        "title": "ModBear: Show Status Bar Menu"
      }
    ],
    "configuration": {
      "title": "ModBear",
      "properties": {
        "modBear.enabled": {
          "type": "boolean",
          "default": true
        },
        "modBear.go.path": {
          "type": "string",
          "default": "go",
          "scope": "window"
        },
        "modBear.govulncheck.path": {
          "type": "string",
          "default": "govulncheck",
          "scope": "window"
        },
        "modBear.scan.onOpen": {
          "type": "boolean",
          "default": true
        },
        "modBear.scan.onSave": {
          "type": "boolean",
          "default": true
        },
        "modBear.scan.updateTtlMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 1440
        },
        "modBear.scan.maxConcurrentModules": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8
        },
        "modBear.scan.timeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "maximum": 900
        },
        "modBear.vulnerability.enabled": {
          "type": "boolean",
          "default": true
        },
        "modBear.vulnerability.timeoutSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 30,
          "maximum": 1800
        },
        "modBear.inlayHints.enabled": {
          "type": "boolean",
          "default": true
        },
        "modBear.inlayHints.showIndirect": {
          "type": "boolean",
          "default": true
        },
        "modBear.inlayHints.showUpToDate": {
          "type": "boolean",
          "default": false
        },
        "modBear.inlayHints.showUpdateKind": {
          "type": "boolean",
          "default": true
        },
        "modBear.diagnostics.updateSeverity": {
          "type": "string",
          "enum": [
            "none",
            "information",
            "warning"
          ],
          "default": "none"
        },
        "modBear.output.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); ['out', 'dist'].forEach(d => fs.rmSync(d, { recursive: true, force: true })); fs.readdirSync('.').filter(f => f.endsWith('.vsix')).forEach(f => fs.rmSync(f, { force: true }))\"",
    "compile": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "bundle": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test:unit:run": "node --test 'out/test/unit/**/*.test.js'",
    "test:unit": "npm run compile && npm run test:unit:run",
    "test:integration:run": "node --test 'out/test/integration/**/*.test.js'",
    "test:integration": "npm run compile && npm run test:integration:run",
    "test:extension:run": "node out/test/runExtensionTests.js",
    "test:extension": "npm run compile && npm run bundle && npm run test:extension:run",
    "test:commits": "bash .github/scripts/validate-commits.sh",
    "test:release": "node scripts/test-release-config.mjs",
    "test": "npm run compile && npm run test:unit:run && npm run test:integration:run",
    "verify": "npm run compile && npm run test:unit:run && npm run test:integration:run",
    "package": "npm run check && npm run bundle && vsce package --no-dependencies",
    "package:vsix": "npm run clean && npm run verify && npm run package",
    "vscode:prepublish": "npm run clean && npm run bundle"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.109.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.0.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "esbuild": "^0.28.1",
    "glob": "^11.0.0",
    "js-yaml": "^5.2.1",
    "mocha": "^11.7.6",
    "semantic-release": "^25.0.8",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "diff": "8.0.4",
    "serialize-javascript": "7.0.5"
  }
}
